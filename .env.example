# Локальная модель через Ollama (OpenAI-совместимый эндпойнт).
# Когда организаторы дадут свой API — заменить три значения ниже, код не трогать.
# Без этого файла тренажёр тоже работает: эвристики + шаблонные реплики.
NEGO_LLM_PROVIDER=openai
NEGO_LLM_BASE_URL=http://127.0.0.1:11434/v1
NEGO_LLM_API_KEY=ollama
NEGO_LLM_MODEL=qwen3:4b-instruct
# Локальная модель на ноутбучной видеокарте отвечает десятки секунд — таймаут с запасом.
NEGO_LLM_TIMEOUT=180
